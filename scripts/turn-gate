#!/bin/sh

set -eu

state_directory=".agent-state"
state_file="$state_directory/active-task"

usage() {
    echo "usage: scripts/turn-gate {start <goal>|status|check-final|clear <complete|blocked|status>}" >&2
    exit 2
}

command_name="${1:-}"

case "$command_name" in
    start)
        shift
        [ "$#" -gt 0 ] || usage
        mkdir -p "$state_directory"
        printf '%s\n' "$*" > "$state_file"
        echo "active: $*"
        ;;
    status)
        if [ -f "$state_file" ]; then
            printf 'active: '
            cat "$state_file"
        else
            echo "inactive"
        fi
        ;;
    check-final)
        if [ -f "$state_file" ]; then
            printf 'final blocked while active: ' >&2
            cat "$state_file" >&2
            exit 1
        fi
        echo "final allowed"
        ;;
    clear)
        reason="${2:-}"
        case "$reason" in
            complete|blocked|status)
                rm -f "$state_file"
                echo "cleared: $reason"
                ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
